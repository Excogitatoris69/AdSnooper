<Window x:Class="AdSnooperGui.views.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdSnooperGui.views"
        xmlns:vm="clr-namespace:AdSnooperGui.viewmodels"
        xmlns:models="clr-namespace:AdSnooperGui.models"
        xmlns:p="clr-namespace:AdSnooperGui.Properties"
        mc:Ignorable="d"
        Title="{Binding title, FallbackValue=CustomMessageBox}" Height="130" Width="300" MinHeight="150" MinWidth="400" ResizeMode="CanResize" 
        Icon="/images/ADSnooper.ico" 
        PreviewKeyDown="window_handleKeystrokeEvents" 
        >
    <!-- 
    <Window.DataContext>
        Dazu muss in der Klasse ein StandardKonsturktor existieren 
        <vm:CustomMessageBoxVM />
    </Window.DataContext>
    -->


    <Grid Background="{StaticResource PrimaryColor_06}">
        <Grid.ColumnDefinitions>
            <!-- Image -->
            <ColumnDefinition Width="70" />
            <!-- Content -->
            <ColumnDefinition Width="*" />
            <!-- Buttons -->
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <!-- image -->
        <Image  Grid.Row="0" Grid.Column="0" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"
                Source="{Binding imageSource }"  />


        <!-- 

        <Image  x:Name="messageImage" Source="/images/ExclamationmarkRed.png" VerticalAlignment="Top"
                RenderOptions.BitmapScalingMode="HighQuality"
                Grid.Row="0" Grid.Column="0" Margin="10" />
        -->

        <!-- content -->
        <!-- 
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource PrimaryColor_06}" >
        </StackPanel>
            <Image Source="{Binding imageSource, FallbackValue=/images/QuestionmarkBlue.png}" Width="50" Height="50" Margin="0,20,0,0" />
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,5,0" Background="White"  >
        </StackPanel>
        -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,5,0" Background="White">
            <TextBox x:Name="tbMessage" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                        Margin="2" Text="{Binding messageText, FallbackValue=no_Data}" TextWrapping="Wrap" IsReadOnly="True" />
        </ScrollViewer>
        <!-- 
        <ProgressBar Minimum="0" Maximum="90" Name="pbSearchGroup" 
        Visibility="{Binding isProgressBarSearchGroupVisibility}" IsIndeterminate="false" 
        Value="{Binding progressBarSearchGroupValue}" Height="10" Margin="0,5,0,0" />
        -->
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,5,0">
            <ProgressBar Height="6" Width="316" x:Name="pgBar" Minimum="0" Maximum="{Binding progressBarMaxValue}" IsIndeterminate="False" 
                         Visibility="{Binding isProgressBarVisibility}" 
                         Value="{Binding progressBarValue}"/>
        </StackPanel>
        <!-- button -->
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,10,10,10" HorizontalAlignment="Right" Background="{StaticResource PrimaryColor_06}">
            <Button Template="{DynamicResource ButtonTemplate1}" x:Name="btn2" Click="btn2_Click" IsDefault="{Binding button2isDefault}" Visibility="{Binding button2Visibility, FallbackValue=Visible}" Content="{Binding button2Label, FallbackValue=btn2}" Margin="5,0,0,0" MinWidth="50" >
            </Button>
            <Button Template="{DynamicResource ButtonTemplate1}" x:Name="btn1" Click="btn1_Click" IsDefault="{Binding button1isDefault}" Visibility="{Binding button1Visibility, FallbackValue=Visible}" Content="{Binding button1Label, FallbackValue=btn1}" Margin="5,0,0,0" MinWidth="50" >
            </Button>
            <Button Template="{DynamicResource ButtonTemplate1}" x:Name="btn0" Click="btn0_Click" IsDefault="{Binding button0isDefault}" Visibility="{Binding button0Visibility, FallbackValue=Visible}" Content="{Binding button0Label, FallbackValue=btn0}" Margin="10,0,0,0" MinWidth="50"  >
            </Button>
        </StackPanel>
    </Grid>
</Window>
