<Window x:Class="AdSnooperGui.views.CustomInputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdSnooperGui.views"
        xmlns:vm="clr-namespace:AdSnooperGui.viewmodels"
        xmlns:models="clr-namespace:AdSnooperGui.models"
        xmlns:p="clr-namespace:AdSnooperGui.Properties"
        mc:Ignorable="d"
        Title="{Binding title, FallbackValue=CustomMessageBox}" Height="130" Width="300" MinHeight="180" MinWidth="400" ResizeMode="CanResize" 
        Icon="/images/ADSnooper.ico" 
        PreviewKeyDown="window_handleKeystrokeEvents" 
        >


    <Grid Background="{StaticResource PrimaryColor_06}">
        
        <Grid.ColumnDefinitions>
            <!-- Image -->
            <ColumnDefinition Width="70"  />
            <!-- Content -->
            <ColumnDefinition Width="*" />
            <!-- Buttons -->
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="70" />
            <RowDefinition Height="25" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions> 
        <!-- image -->
        <Image  Grid.Row="0" Grid.Column="0" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"
        Source="{Binding imageSource }"  />
        <!-- Message -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,5,10,5" Background="White">
            <TextBox x:Name="tbMessage"  Text="{Binding messageText, FallbackValue=no_Data}" IsReadOnly="True" Background="{StaticResource PrimaryColor_06}" />
        </ScrollViewer>
        <!-- Input content -->
        <TextBox  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="tbInput" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" 
            Margin="5,2,10,2" Text="{Binding inputText, UpdateSourceTrigger=PropertyChanged, FallbackValue=no_Data}" TextWrapping="Wrap" IsReadOnly="False" />
        <!-- button -->
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,10,10,10" HorizontalAlignment="Right" Background="{StaticResource PrimaryColor_06}">
            <Button Template="{DynamicResource ButtonTemplate1}" x:Name="btn1" Click="btn1_Click" Visibility="{Binding button1Visibility, FallbackValue=Visible}" Content="{Binding button1Label, FallbackValue=btn1}" Margin="5,0,0,0" MinWidth="50" >
            </Button>
            <Button Template="{DynamicResource ButtonTemplate1}" x:Name="btn0" Click="btn0_Click" Visibility="{Binding button0Visibility, FallbackValue=Visible}" Content="{Binding button0Label, FallbackValue=btn0}" Margin="10,0,0,0" MinWidth="50"  >
            </Button>
        </StackPanel>
    </Grid>
</Window>
