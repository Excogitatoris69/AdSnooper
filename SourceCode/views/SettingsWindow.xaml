<Window x:Class="AdSnooperGui.views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdSnooperGui.views"
        xmlns:vm="clr-namespace:AdSnooperGui.viewmodels"
        xmlns:models="clr-namespace:AdSnooperGui.models"
        xmlns:p="clr-namespace:AdSnooperGui.Properties"
        mc:Ignorable="d"
        Title="{Binding windowTitle}" Height="350" Width="600"
        ResizeMode="NoResize" 
        Icon="/images/ADSnooper.ico" 
        >
    <Grid>
        <TabControl Margin="10">
            <TabItem Header="Info">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Background="{StaticResource PrimaryColorGradient_01}">
                        <Image Source="/images/ADSnooper.png" Width="130" Height="180" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,10,5,5" >
                        <Label Content="{Binding versionString,FallbackValue='AD Snooper V1.1'}" />
                        <Label Content="{Binding authorString,FallbackValue='created by Oliver Matle'}" />
                        <TextBox Text="{Binding contactString,FallbackValue='Internet: www.xxx.de       e-Mail: xxx@yyy.de'}" IsReadOnly="True" BorderThickness="0" Margin="3,0,0,0" />
                        <Separator />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="350" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{x:Static p:Resources.L083_Customer}" ContentStringFormat="{}{0}:" />
                            <Label Grid.Row="0" Grid.Column="1" Content="{Binding licenseCustomerString,FallbackValue=Oliver}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="{x:Static p:Resources.L084_Address}" ContentStringFormat="{}{0}:" />
                            <Label Grid.Row="1" Grid.Column="1" Content="{Binding licenseAddressString,FallbackValue='Meine Str. 1, 12345 Eine Stadt'}" />

                            <Label Grid.Row="2" Grid.Column="0" Content="{x:Static p:Resources.L085_LicenseType}" ContentStringFormat="{}{0}:" />
                            <Label Grid.Row="2" Grid.Column="1" Content="{Binding licenseTypeString}" />

                            <Label Grid.Row="3" Grid.Column="0" Content="{x:Static p:Resources.L090_ExpireDate}" ContentStringFormat="{}{0}:" Visibility="{Binding expireDateVisibility}" />
                            <Label Grid.Row="3" Grid.Column="1" Content="{Binding licenseExpireDateString}" Visibility="{Binding expireDateVisibility}" />
                            <Label Grid.Row="3" Grid.Column="0" Content="{x:Static p:Resources.L092_Count}" ContentStringFormat="{}{0}:" Visibility="{Binding volumeSizeVisibility}" />
                            <Label Grid.Row="3" Grid.Column="1" Content="{Binding licenseVolumeSizeString}" Visibility="{Binding volumeSizeVisibility}" />

                            <Label Grid.Row="5" Grid.Column="1" Content="{Binding warningMessageText}" Visibility="{Binding warningMessageVisibility}" Foreground="Red"/>
                        </Grid>
                        <Label Content="" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{x:Static p:Resources.L030_Settings}">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="5,10,5,5" >
                        <Label Content="{x:Static p:Resources.L029_Language}" VerticalAlignment="Center" />
                        <ComboBox Name="cbLanguage" Width="200" ItemsSource="{Binding languageList}" SelectedIndex="{Binding languageListSelectedIndex}" SelectionChanged="ComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate >
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding displayName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- 
                        -->
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="{x:Static p:Resources.L082_License}" Height="20" VerticalAlignment="Top" >
                <StackPanel Orientation="Vertical">
                    <!-- 
                    Linefeed:  &#x0a;
                    < &#60;
                    > &#62;
                    / &#47;
                    <Bold>  &#60;Bold&#62;
                    </Bold> &#60;Bold&#47;&#62;
                               Text="Purchasing is easy!&#x0a;1) Fill in the fields.&#x0a;2) Create a request file and send it via email to 'order@dingsda.com'.&#x0a;3) Pay the invoice.&#x0a;4) Receive the license file via email and import it." 
                    -->
                    <TextBlock TextWrapping="Wrap"  Margin="5,5,5,5" Background="#FFC3FF9C" Height="90"
                               Text="{Binding purchasingText}" 
                               />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="350" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="{x:Static p:Resources.L086_YourName}" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbName" VerticalAlignment="Center" Text="{Binding orderCustomerString}" />

                        <Label Grid.Row="1" Grid.Column="0" Content="{x:Static p:Resources.L087_Street}" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbAddress" VerticalAlignment="Center" Text="{Binding orderAddressStreetString}" />

                        <Label Grid.Row="2" Grid.Column="0" Content="{x:Static p:Resources.L088_City}" />
                        <TextBox Grid.Row="2" Grid.Column="1"  VerticalAlignment="Center" Text="{Binding orderAddressCityString}" />

                        <Label Content="{x:Static p:Resources.L085_LicenseType}" Grid.Row="3" Grid.Column="0" />
                        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" >
                            <ComboBox x:Name="cbLicenseType" Width="100" Height="23" 
                                      ItemsSource="{Binding licenseTypeList}" SelectedIndex="{Binding licenseTypeListSelectedIndex}"
                                      SelectionChanged="cbLicenseType_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding displayName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Label Content="{x:Static p:Resources.L092_Count}" Margin="10,0,0,0" Visibility="{Binding orderVolumeSizeVisibility}" />
                            <TextBox x:Name="tbCount" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                     Text="{Binding orderVolumeSizeString}" Width="60"
                                     Visibility="{Binding orderVolumeSizeVisibility}"/>
                        </StackPanel>
                        
                        
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{x:Static p:Resources.L093_CreateOrderFile}" Width="120" Margin="0,5,0,0" Click="Button_Click_WriteOrderfile" />
                            <Button Content="{x:Static p:Resources.L094_ImportLicenseFile}" Width="120" Margin="10,5,0,0" Click="Button_Click_ImportOrderfile" />
                        </StackPanel>
                        
                    </Grid>
                </StackPanel>
            </TabItem>
            
        </TabControl>
        
    </Grid>
</Window>
