<Window x:Class="AdSnooperGui.views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdSnooperGui.views"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:common="clr-namespace:AdSnooperGui.common"
        xmlns:vm="clr-namespace:AdSnooperGui.viewmodels"
        xmlns:uc="clr-namespace:AdSnooperGui.UserControls"
        xmlns:models="clr-namespace:AdSnooperGui.models"
        xmlns:p="clr-namespace:AdSnooperGui.Properties"
        mc:Ignorable="d"
        Title="{Binding windowTitle}"
        Left="{Binding appSettings.A001_MainPosX, Mode=TwoWay}"
        Top="{Binding appSettings.A002_MainPosY , Mode=TwoWay}"
        Height="{Binding appSettings.A003_MainHeight  , Mode=TwoWay}" MinHeight="300"
        Width= "{Binding appSettings.A004_MainWidth  , Mode=TwoWay}" MinWidth="500"
        Icon="/images/ADSnooper.ico" 
        >
    <Window.InputBindings>
        <KeyBinding Key="f1" Command="{Binding cmdOpenHelpWindow}" />
        <KeyBinding Key="Esc" Command="{Binding cmdCancelSearch}" />
    </Window.InputBindings>
    <!-- 
    <Window.DataContext>
        <vm:MainWindowVM x:Name="vm" />
    </Window.DataContext>
    -->
    <Window.Resources>
        <common:GridSizeConverter x:Key="GridSizeConverter" />
        <ControlTemplate x:Key="TabWithToolbarTemplate" TargetType="TabControl" >
            <Grid KeyboardNavigation.TabNavigation="Local" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Background="{StaticResource PrimaryColor_05}">
                    <TabPanel Name="HeaderPanel"
                      IsItemsHost="True"
                      Panel.ZIndex="1"
                      Margin="3,3,5,0"
                      DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                        <!-- 
                        <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdOpenHelpWindow}" Margin="0,0,5,0"  >
                            <Image Source="/images/Book.png" Stretch="Fill" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                        </Button>
                        -->
                        <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdOpenSettingsWindow}" Margin="0,0,10,0"  >
                            <Image Source="/images/SettingsGear.png" Stretch="Fill" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                        </Button>
                    </StackPanel>
                </DockPanel>
                <ContentPresenter x:Name="PART_SelectedContentHost"
                          Grid.Row="1" 
                          Margin="3"
                          ContentSource="SelectedContent"/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 
        {StaticResource PrimaryColor_01}
        <StackPanel DockPanel.Dock="Top"  Height="40">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="..." Width="30" Margin="5" Height="30" Command="{Binding cmdOpenSettingsWindow}" />
            </StackPanel>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom">
            <ProgressBar Minimum="0" Maximum="100" Name="pbSearch" IsIndeterminate="True" Height="5"/>
        </Grid>
        -->

        <Grid DockPanel.Dock="Top">
            <TabControl Template="{StaticResource TabWithToolbarTemplate}"  >
                <!-- ********************************************* -->
                <!-- Tab Person -->
                <!-- ********************************************* -->
                <!--#region tab person -->
                <TabItem Header="{x:Static p:Resources.L005_Person}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- search -->
                            <ColumnDefinition Width="{Binding appSettings.A005_SearchPersonAreaWidth, Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" MinWidth="200"  MaxWidth="600"/>
                            <!-- splitter -->
                            <ColumnDefinition Width="3" />
                            <!-- content -->
                            <ColumnDefinition Width="*"  />
                        </Grid.ColumnDefinitions>
                        <!-- search -->
                        <Grid Grid.Column="0" Background="{StaticResource PrimaryColorGradient_01}">
                            <Grid.RowDefinitions>
                                <!-- Settings button -->
                                <RowDefinition Height="0" />
                                <!-- Search -->
                                <RowDefinition Height="230" />
                                <!-- Flex place -->
                                <RowDefinition Height="*" />
                                <!-- Image -->
                                <RowDefinition Height="300" MinHeight="100" />

                            </Grid.RowDefinitions>
                            <!-- buttons -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" >
                                <!-- 
                                 Settings button 
                                <Button Template="{DynamicResource ButtonTemplate1}"  Width="40" Margin="5" Height="28" IsTabStop="False" HorizontalAlignment="Left" Command="{Binding cmdOpenSettingsWindow}"  >
                                    <Image Source="/images/Settings.png" Stretch="Fill" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                                </Button>
                                 Help button
                                <Button  Template="{DynamicResource ButtonTemplate1}" Width="40" Margin="5" Height="28"  HorizontalAlignment="Left" Command="{Binding cmdOpenHelpWindow}"  >
                                    <Image Source="/images/QuestionmarkWhite32.png" Width="20" Height="20"  />
                                </Button>
                                -->
                            </StackPanel>
                            <!-- Search -->
                            <Grid Grid.Row="1" >
                                <!-- SearchInputFields -->
                                <StackPanel Orientation="Vertical" Margin="0,0,0,0" >
                                    <StackPanel Orientation="Vertical" Margin="5,0,5,0" >
                                        <ItemsControl ItemsSource="{Binding searchPersonFieldList, Mode=TwoWay, NotifyOnSourceUpdated=True }" >
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="25" />
                                                        </Grid.RowDefinitions>
                                                        <Label Grid.Column="0" Grid.Row="0" Margin="0,4,0,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="2,0,0,0" Content="{Binding labelName}"  Foreground="{StaticResource PrimaryColor_03}" Background="{StaticResource PrimaryColor_06}" />
                                                        <TextBox Grid.Column="1" Grid.Row="0" Margin="0,4,0,0" Padding="0,0,0,0" TextWrapping="NoWrap" MinWidth="50" Text="{Binding textFieldValue, UpdateSourceTrigger=PropertyChanged}" TabIndex="{Binding tabIndex}" />

                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <!-- SearchButton -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,5,0" HorizontalAlignment="Right">
                                        <Button Template="{DynamicResource ButtonTemplate2}" Content="C" IsTabStop="False" Width="40" Height="25" Margin="0,0,10,0" Command="{Binding cmdClearSearchfields}" />
                                        <Button Template="{DynamicResource ButtonTemplate1}" Content="{x:Static p:Resources.L001_Search}" IsDefault="False" Command="{Binding cmdSearch}" 
                                                CommandParameter="{x:Static common:Constants.CommandParameterPerson}" IsTabStop="False" Width="80" Height="25" Margin="0,0,0,0" />

                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <!-- Image -->
                            <Image Grid.Row="3" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Source="/images/ADSnooper.png" Width="200" Height="300" HorizontalAlignment="Left" Margin="20,0,0,0" />
                        </Grid>
                        <!-- splitter -->
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryColor_01}" />
                        <!-- content -->
                        <Grid Grid.Column="2" >
                            <Grid.RowDefinitions>
                                <!-- Searchresult Table -->
                                <RowDefinition Height="*" MinHeight="100" />
                                <!-- Splitter -->
                                <RowDefinition Height="3" />
                                <!-- Details -->
                                <RowDefinition Height="{Binding appSettings.A007_PersonSearchResultAreaHeight, Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" MinHeight="100" />
                            </Grid.RowDefinitions>
                            <!-- Searchresult Table -->
                            <DataGrid Grid.Row="0"  Name="dataGridPersonResult" SelectionChanged="DataGridPersonResult_SelectionChanged"  
                                      CanUserResizeRows="False" CanUserReorderColumns="False" AutoGenerateColumns="False" 
                                      ItemsSource="{Binding personSearchResultTableList }"  IsReadOnly="True" SelectionMode="Extended" 
                                      LayoutUpdated="dataGridPersonResult_LayoutUpdated">
                                <!-- jetzt dynamisch
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding lineNumber}" Width="50" />
                                    <DataGridTextColumn Header="{x:Static p:Resources.L008_PersonalId}" Binding="{Binding personalId}" Width="80" />
                                    <DataGridTextColumn Header="{x:Static p:Resources.L009_Salutation}" Binding="{Binding salutation}" Width="70" />
                                    <DataGridTextColumn Header="{x:Static p:Resources.L011_FirstName}" Binding="{Binding firstName}" Width="150" />
                                    <DataGridTextColumn Header="{x:Static p:Resources.L012_LastName}" Binding="{Binding lastName}" Width="150" />
                                    <DataGridTextColumn Header="{x:Static p:Resources.L013_Department}" Binding="{Binding department}" Width="80" />
                                    <DataGridTextColumn Header="{x:Static p:Resources.L023_Company}" Binding="{Binding company}" Width="150" />
                                    <DataGridTextColumn Header="{x:Static p:Resources.L021_Location}" Binding="{Binding location}" Width="120" />
                                </DataGrid.Columns>
                                -->
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <!-- 
                                        <MenuItem Header="{x:Static p:Resources.L054_Copy}" Command="{Binding cmdPersonCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyAll}" >
                                            <MenuItem.Icon>
                                                <Image Source="/images/CopyTable.png" />

                                            </MenuItem.Icon>
                                        </MenuItem>
                                        -->
                                        <MenuItem Header="{x:Static p:Resources.L065_CopyPersonalIdAsCsv}" Command="{Binding cmdPersonCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyAsCSV}" >
                                            <MenuItem.Icon>
                                                <Image Source="/images/CopyCsv.png" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static p:Resources.L080_CopyEmailAsCsv}" Command="{Binding cmdPersonMailCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyAsCSV}" >
                                            <MenuItem.Icon>
                                                <Image Source="/images/CopyCsv.png" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static p:Resources.L053_Export2}" Command="{Binding cmdOpenPersonExportWindow}" CommandParameter="{x:Static common:Constants.CommandParameterPerson}"  >
                                            <MenuItem.Icon>
                                                <Image Source="/images/Export.png" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static p:Resources.L064_DiffGroups2}" Command="{Binding cmdOpenGroupDiffWindow}"  >
                                            <MenuItem.Icon>
                                                <Image Source="/images/Compare.png" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                            <!-- Splitter -->
                            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryColor_01}"  />
                            <!-- Details -->
                            <Grid Grid.Row="2"  >
                                <Grid.ColumnDefinitions>
                                    <!-- Propertylist -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Splitter -->
                                    <ColumnDefinition Width="3" />
                                    <!-- Group Memberlist -->
                                    <ColumnDefinition Width="{Binding appSettings.A006_PersonPropertiesAreaWidth, Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" MinWidth="200"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- ********************************************* -->
                                <!-- Propertylist -->
                                <!-- ********************************************* -->
                                <DataGrid Grid.Row="0" Grid.Column="0" Name="dataGridPersonProperties" CanUserResizeRows="False" CanUserReorderColumns="False" AutoGenerateColumns="False" ItemsSource="{Binding personPropertyList }" 
                                          IsReadOnly="True" SelectionMode="Extended" SelectionChanged="DataGridPersonProperties_SelectionChanged" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding order}" Width="30" />
                                        <DataGridTextColumn Header="{x:Static p:Resources.L002_Property}" Binding="{Binding displayName}" Width="120" />
                                        <DataGridTextColumn Header="{x:Static p:Resources.L003_Value}" Binding="{Binding propertyValue}" Width="300" />
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <!-- 
                                            -->
                                            <MenuItem Header="{x:Static p:Resources.L054_Copy}" Command="{Binding cmdPersonPropertiesCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyKeyValue}" >
                                                <MenuItem.Icon>
                                                    <Image Source="/images/CopyTable.png" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{x:Static p:Resources.L055_CopyValue}" Command="{Binding cmdPersonPropertiesCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyValueOnly}" >
                                                <MenuItem.Icon>
                                                    <Image Source="/images/CopyValue.png" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                                <!-- ********************************************* -->
                                <!-- Splitter -->
                                <!-- ********************************************* -->
                                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryColor_01}"  />
                                <!-- ********************************************* -->
                                <!-- Group Memberlist -->
                                <!-- ********************************************* -->
                                <Grid Grid.Row="0" Grid.Column="2">
                                    <!-- Bei Verwendung von CollectionView immer Grid nehmen anstatt StackPanel, damit die Größenänderungen an den Scroller weitergereicht werden.-->
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Textfilter -->
                                    <Label Grid.Row="0" Grid.Column="0" Content="{x:Static p:Resources.L068_Filter}" Margin="0,0,0,0" Foreground="{StaticResource PrimaryColor_03}" Background="{StaticResource PrimaryColor_06}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbGroupMemberTextFilter" Text="" IsManipulationEnabled="True" Height="22"  VerticalContentAlignment="Center" TextChanged="tbGroupMemberTextFilter_TextChanged" />
                                    <!-- Member table -->
                                    <DataGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="dataGridMemberOfGroup" CanUserResizeRows="False" CanUserReorderColumns="False" AutoGenerateColumns="False" 
                                        IsReadOnly="True" SelectionMode="Extended" SelectionChanged="DataGridPersonGroups_SelectionChanged"
                                        ItemsSource="{Binding personGroupMemberList }" >
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding order}" Width="40" />
                                            <DataGridTextColumn Header="{x:Static p:Resources.L004_MemberOfGroups}" Binding="{Binding shortName}" Width="330" />
                                            <DataGridTextColumn Header="{x:Static p:Resources.L062_DistinguishedName}" Binding="{Binding distinguishedName}" Width="530" />
                                            <!-- 
                                            <DataGridTextColumn Header="{x:Static p:Resources.L079_Subgroup}" Binding="{Binding subgroupMarker}" Width="80" />
                                            -->
                                        </DataGrid.Columns>
                                        <!-- 
                                        -->
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <!-- 
                                                <MenuItem Header="{x:Static p:Resources.L054_Copy}" Command="{Binding cmdPersonGroupsCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyAll}" >
                                                    <MenuItem.Icon>
                                                        <Image Source="/images/CopyList.png" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{x:Static p:Resources.L066_CopyAsCsv}" Command="{Binding cmdPersonGroupsCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyAsCSV}" >
                                                    <MenuItem.Icon>
                                                        <Image Source="/images/CopyCsv.png" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                -->
                                                <MenuItem Header="{x:Static p:Resources.L057_CopyNameOnly}" Command="{Binding cmdPersonGroupsCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyAsCSV}" >
                                                    <MenuItem.Icon>
                                                        <Image Source="/images/CopyCsv.png" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
                <!--#endregion-->
                <!-- ********************************************* -->
                <!-- Tab Group -->
                <!-- ********************************************* -->
                <!--#region tab group -->
                <TabItem Header="{x:Static p:Resources.L006_Group}" RenderTransformOrigin="0.5,0.5">
                    <TabItem.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-0.398"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TabItem.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- search -->
                            <ColumnDefinition Width="{Binding appSettings.A008_SearchGroupAreaWidth, Mode=TwoWay, Converter={StaticResource GridSizeConverter}}"  MinWidth="200"  MaxWidth="600" />
                            <!-- splitter -->
                            <ColumnDefinition Width="3" />
                            <!-- content -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- search -->
                        <Grid Grid.Column="0" Background="{StaticResource PrimaryColorGradient_01}" >
                            <Grid.RowDefinitions>
                                <!-- Settings button -->
                                <RowDefinition Height="0" />
                                <!-- Search -->
                                <RowDefinition Height="200" />
                                <!-- Flex place -->
                                <RowDefinition Height="*" />
                                <!-- Image -->
                                <RowDefinition Height="300" />
                            </Grid.RowDefinitions>
                            <!-- button -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" >
                                <!-- 
                                Settings button 
                                <Button  Template="{DynamicResource ButtonTemplate1}" Grid.Row="0" Width="40" Margin="5" Height="28" HorizontalAlignment="Left" Command="{Binding cmdOpenSettingsWindow}"  >
                                    <Image Source="/images/Settings.png" Stretch="Fill" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                                </Button>
                                Help button 
                                <Button Template="{DynamicResource ButtonTemplate1}" Width="40" Margin="5" Height="28"  HorizontalAlignment="Left" Command="{Binding cmdOpenHelpWindow}"  >
                                    <Image Source="/images/QuestionmarkWhite32.png" Width="20" Height="20"  />
                                </Button>
                                -->
                            </StackPanel>
                            <!-- Search -->
                            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,0" >
                                <!-- SearchInputFields -->
                                <StackPanel Orientation="Vertical" Margin="5,0,5,0" >
                                    <ItemsControl x:Name="searchgroupfieldlist1" ItemsSource="{Binding searchGroupFieldList, Mode=TwoWay, NotifyOnSourceUpdated=True}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25" />
                                                    </Grid.RowDefinitions>
                                                    <Label Grid.Column="0" Grid.Row="0" Margin="0,4,0,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="2,0,0,0" Content="{Binding labelName}"  Foreground="{StaticResource PrimaryColor_03}" Background="{StaticResource PrimaryColor_06}" />
                                                    <!-- Autocomplete Input suggestion -->
                                                    <uc:AutoCompleteTextBox AutoSuggestionList="{Binding autoCompleteSuggestionList}"
                                                        Grid.Column="1" Grid.Row="0" Margin="0,4,0,0" Padding="0,0,0,0" 
                                                        Text="{Binding textFieldValue, UpdateSourceTrigger=PropertyChanged}"
                                                        SuggestionListWidth="500" SuggestionListHeight="300" SuggestionListMaxEntries="50"
                                                        />
                                                    <!-- 
                                                    <TextBox Grid.Column="1" Grid.Row="0" Margin="0,4,0,0" Padding="0,0,0,0" TextWrapping="NoWrap"  
                                                        Text="{Binding textFieldValue, UpdateSourceTrigger=PropertyChanged}" />
                                                    -->
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ProgressBar Minimum="0" Maximum="90" Name="pbSearchGroup" Visibility="{Binding isProgressBarSearchGroupVisibility}" IsIndeterminate="false" Value="{Binding progressBarSearchGroupValue}" Height="10" Margin="0,5,0,0" />
                                </StackPanel>
                                <!-- SearchButton -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,5,0" HorizontalAlignment="Right">
                                    <Button Template="{DynamicResource ButtonTemplate1}" Content="{x:Static p:Resources.L001_Search}" Command="{Binding cmdSearch}" CommandParameter="{x:Static common:Constants.CommandParameterGroup}" Width="80" Height="25" Margin="0,0,0,0"   >
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <!-- Image -->
                            <Image Grid.Row="3" VerticalAlignment="Top" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" Source="/images/ADSnooper.png" Width="200" Height="300" Margin="20,0,0,0" />
                        </Grid>
                        <!-- splitter -->
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryColor_01}"  />
                        <!-- content -->
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <!--  Search result -->
                                <ColumnDefinition Width="*" MinWidth="200"   />
                                <!-- Splitter -->
                                <ColumnDefinition Width="3" />
                                <!-- Member -->
                                <ColumnDefinition Width="{Binding appSettings.A009_GroupSearchResultAreaWidth, Mode=TwoWay, Converter={StaticResource GridSizeConverter}}" MinWidth="150" />
                            </Grid.ColumnDefinitions>
                            <!--  Search result -->
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="{x:Static p:Resources.L068_Filter}" Margin="0,0,0,0" Foreground="{StaticResource PrimaryColor_03}" Background="{StaticResource PrimaryColor_06}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbGroupTextFilter" Text="" IsManipulationEnabled="True" Height="22" VerticalContentAlignment="Center" TextChanged="tbGroupTextFilter_TextChanged" />
                                <DataGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="dataGridGroupResult" SelectionChanged="DataGridGroupResult_SelectionChanged" CanUserResizeRows="False" CanUserReorderColumns="False" AutoGenerateColumns="False" ItemsSource="{Binding groupSearchResultTableList}" IsReadOnly="True" SelectionMode="Extended" >
                                    <!-- 
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Width="40" Binding="{Binding lineNumber}" />
                                        <DataGridTextColumn Header="{x:Static p:Resources.L056_GroupName}" Binding="{Binding name}" Width="280" />
                                        <DataGridTextColumn Header="{x:Static p:Resources.L062_DistinguishedName}" Binding="{Binding distinguishedName}" Width="280" />
                                        <DataGridTextColumn Header="{x:Static p:Resources.L018_Description}" Binding="{Binding description}" Width="300" />
                                    </DataGrid.Columns>
                                    -->
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <!-- 
                                            <MenuItem Header="{x:Static p:Resources.L054_Copy}" Command="{Binding cmdGroupCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyGroupAllProperties}"  >
                                                <MenuItem.Icon>
                                                    <Image Source="/images/CopyTable.png" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{x:Static p:Resources.L076_CopyDistinguishedNameOnly}" Command="{Binding cmdGroupCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyGroupDistinguishedOnly}"  >
                                                <MenuItem.Icon>
                                                    <Image Source="/images/CopyCsv.png" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            -->
                                            <MenuItem Header="{x:Static p:Resources.L081_CopyNameAsCsv}" Command="{Binding cmdGroupNameCopyClipboard}" CommandParameter="{x:Static common:Constants.CommandParameterCopyGroupNameOnly}"  >
                                                <MenuItem.Icon>
                                                    <Image Source="/images/CopyCsv.png" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{x:Static p:Resources.L053_Export2}" Command="{Binding cmdOpenGroupExportWindow}" CommandParameter="{x:Static common:Constants.CommandParameterGroup}"  >
                                                <MenuItem.Icon>
                                                    <Image Source="/images/Export.png" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </Grid>

                            <!-- 
                            
                            -->
                            <!-- Splitter -->
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryColor_01}"  />
                            <!-- Memberlist -->
                            <Grid  Grid.Column="2" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- textfilter -->
                                <Label Grid.Row="0" Grid.Column="0" Content="{x:Static p:Resources.L068_Filter}" Margin="0,0,0,0" Foreground="{StaticResource PrimaryColor_03}" Background="{StaticResource PrimaryColor_06}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbGroupMemberTextFilter2" Text="" IsManipulationEnabled="True" Height="22"  VerticalContentAlignment="Center" TextChanged="tbGroupMemberTextFilter2_TextChanged" />
                                <!-- Memberlist -->
                                <DataGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="dataGridGroupMemberlist" 
                                          SelectionChanged="DataGridGroupMemberlist_SelectionChanged" CanUserResizeRows="False" 
                                          AutoGenerateColumns="False" 
                                          ItemsSource="{Binding groupMemberList}" IsReadOnly="True" SelectionMode="Extended" >
                                    <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Width="40" Binding="{Binding order}" />
                                        <DataGridTextColumn Header="{x:Static p:Resources.L026_Name}" Binding="{Binding shortName}" Width="70" />
                                        <DataGridTextColumn Header="{x:Static p:Resources.L062_DistinguishedName}" Binding="{Binding distinguishedName}" Width="200" />
                                        <!-- 
                                        <DataGridTextColumn Header="{x:Static p:Resources.L079_Subgroup}" Binding="{Binding subgroupMarker}" Width="80" />
                                        -->
