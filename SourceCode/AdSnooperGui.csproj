<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ADSnooper</AssemblyName>
    <Copyright>Oliver Matle</Copyright>
    <ApplicationIcon>images\ADSnooper.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Oliver Matle</Authors>
	  <!-- verhindert die vielen Language-Folder im Publish-Verzeichnis -->
    <SatelliteResourceLanguages>XXX</SatelliteResourceLanguages>
    <StartupObject>AdSnooperGui.App</StartupObject>


  </PropertyGroup>

  <ItemGroup>
    <None Remove="images\AddDocument.png" />
    <None Remove="images\ADSnooper.ico" />
    <None Remove="images\ADSnooper.png" />
    <None Remove="images\Book.png" />
    <None Remove="images\Close.png" />
    <None Remove="images\Compare.png" />
    <None Remove="images\CopyBlackWhite32.png" />
    <None Remove="images\CopyCsv.png" />
    <None Remove="images\CopyList.png" />
    <None Remove="images\CopyTable.png" />
    <None Remove="images\CopyValue.png" />
    <None Remove="images\DiskSave.png" />
    <None Remove="images\DiskSaveAs.png" />
    <None Remove="images\ExclamationmarkRed128.png" />
    <None Remove="images\Export.png" />
    <None Remove="images\FileOpen.png" />
    <None Remove="images\InvalidData.png" />
    <None Remove="images\Play.png" />
