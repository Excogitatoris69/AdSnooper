    <None Remove="images\StopRunning.png" />
    <None Remove="images\Trash.png" />
    <None Remove="images\ValidData.png" />
    <None Remove="images\warning.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="images\ADSnooper.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdAdapterSimu\AdAdapterSimu.csproj" />
    <ProjectReference Include="..\AdAdapter\AdAdapter.csproj" />
    <ProjectReference Include="..\CoreAdSnooper\CoreAdSnooper.csproj" />
    <ProjectReference Include="..\DomainAdSnooper\DomainAdSnooper.csproj" />
    <ProjectReference Include="..\ExportAdapter\ExportAdapter.csproj" />
    <ProjectReference Include="..\FileManagementAdapter\FileManagementAdapter.csproj" />
    <ProjectReference Include="..\SqlParserAdapter\SqlParserAdapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="adsnooper.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="AdSnooperRSA.pub">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="documents\ExclamationmarkBlue500.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="images\AddDocument.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\ADSnooper.ico">
