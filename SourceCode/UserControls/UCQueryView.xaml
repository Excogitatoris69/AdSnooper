<UserControl x:Class="AdSnooperGui.UserControls.UCQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdSnooperGui.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="310" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="160" MaxWidth="400" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Batch list -->
        <Grid Grid.Row="0" Grid.Column="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="17" />
                <RowDefinition Height="0" />
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Batch" VerticalContentAlignment="Center" Padding="2,0,0,0" Background="{StaticResource PrimaryColor_01}" Foreground="White" />
            <!-- 
            <ProgressBar Grid.Row="1" Margin="0" IsIndeterminate="True" />
            -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Background="{StaticResource PrimaryColor_06}">
                <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdAddNew}" Margin="3" Background="Transparent" BorderBrush="Transparent" >
                    <Image Source="/images/AddDocument.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>
                
                <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdEdit}" Margin="3" Background="Transparent" BorderBrush="Transparent" >
                    <Image Source="/images/FileOpen.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>

                <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdDelete}" Click="ButtonDelete_Click" Margin="3"  Background="Transparent" BorderBrush="Transparent">
                    <Image Source="/images/Trash.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>
                <!-- Funktioniert noch, aber deaktiviert!
                <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdRun}" Margin="3"  Background="Transparent" BorderBrush="Transparent">
                    <Image Source="/images/Play.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>
                <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdCancel}" Margin="3"  Background="Transparent" BorderBrush="Transparent">
                    <Image Source="/images/StopRunning.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>
                -->
            </StackPanel>
            <DataGrid Grid.Row="3" Name="dataGridBatchList"   
                      CanUserResizeRows="False" CanUserReorderColumns="False" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      ItemsSource="{Binding queryBatchFileItemList}" SelectedIndex="{Binding selectedQueryBatchFileItemListIndex}"
                      SelectionChanged="dataGridBatchList_SelectionChanged" PreviewMouseDoubleClick="dataGridBatchList_PreviewMouseDoubleClick"
                      >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Query List" Binding="{Binding}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>



        <!-- Image -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="{StaticResource PrimaryColorGradient_01}">
        <Image Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Source="/images/ADSnooper.png" Width="200" Height="300" HorizontalAlignment="Left" Margin="20,0,0,0" />
        </StackPanel>
        <!-- 
            <Label Content="Image" />
        -->
        <!-- Split -->
        <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryColor_01}"  />

        <!-- Content: TabControl mit editor, etc -->
        <Grid  Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"  >
            
            <!-- 
            -->
            <TabControl x:Name="tcEditorTabControl" TabStripPlacement="Top" ItemsSource="{Binding editorTabList}" SelectedIndex="{Binding selectedEditorTabIndex}" 
                        SelectionChanged="tcEditorTabControl_SelectionChanged"  >

            </TabControl>
            <!-- 
            
            <TabControl x:Name="tcEditorTabControl2" TabStripPlacement="Top">
                
                <TabItem Style="{DynamicResource TabItemStyleSnooper}" Header="Tab-1"  >
                </TabItem>
                <TabItem Header="Tab-2" />
                <TabItem Header="Tab-3" />
            </TabControl>
            -->

        </Grid>
    </Grid>
</UserControl>
