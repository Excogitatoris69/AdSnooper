<UserControl x:Class="AdSnooperGui.UserControls.UCSqlEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdSnooperGui.UserControls"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:p="clr-namespace:AdSnooperGui.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             PreviewKeyDown="window_handleKeystrokeEvents" 
             >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="3" />
            <RowDefinition Height="250" MinHeight="100" MaxHeight="600" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="300" MinWidth="100" MaxWidth="600"/>
        </Grid.ColumnDefinitions>

        <!-- SQL Editor -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="17" />
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Stretch" Background="#FFBFC9FF">
                <Label Content="SQL Editor"/>
                <Label Content="Batch-1"/>
            </StackPanel>
            -->
            <Label Grid.Row="0" Content="SQL Edit" Padding="2,0,0,0" VerticalContentAlignment="Center" Background="{StaticResource PrimaryColor_01}" Foreground="White" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Background="{StaticResource PrimaryColor_06}">
                <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdRun}" Click="ButtonRun_Click" Margin="3" >
                    <Image Source="/images/Play.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>
                <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdCancel}" Margin="3" >
                    <Image Source="/images/StopRunning.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>
                <Button Template="{DynamicResource ButtonTemplate3}"  Command="{Binding cmdSave}" Click="ButtonSave_Click" Margin="3" >
                    <Image Source="/images/DiskSave.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>
                <Button Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdSaveAs}" Click="ButtonSave_Click" Margin="3" >
                    <Image Source="/images/DiskSaveAs.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>
                <Button x:Name="btnClose" Template="{DynamicResource ButtonTemplate3}" Command="{Binding cmdCloseTab}" Click="ButtonCloseTab_Click" Margin="3" >
                    <Image Source="/images/Close.png" Stretch="Fill" Width="25" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                </Button>
            </StackPanel>
            <!-- 
            <TextBox Grid.Row="2" Name="tbEditor" Text="{Binding editorText}" PreviewKeyUp="tbEditor_PreviewKeyUp"  TextWrapping="Wrap" Background="White" />
            -->
            <avalonEdit:TextEditor Grid.Row="2"
		        Name="textEditor" TextChanged="textEditor_TextChanged"
		        FontFamily="Consolas"  
		        FontSize="10pt" ShowLineNumbers="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                SyntaxHighlighting="C#" Background="White" />
        </Grid>




        <!-- Split 
-->
        <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" Background="{StaticResource PrimaryColor_01}" />

        <!-- Query Control Center -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="17" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="SQL Control" Padding="2,0,0,0" VerticalContentAlignment="Center" Background="{StaticResource PrimaryColor_01}" Foreground="White" />
            <ProgressBar x:Name="pbRunningQuery" Grid.Row="1" Margin="0" IsIndeterminate="true" Visibility="{Binding runningQueryProgressbarVisibility, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource PrimaryColor_06}" />
            <!-- 
            <TextBlock Grid.Row="2" Margin="2" Text="Error in line 4." Background="{StaticResource PrimaryColor_06}" />
            -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="Valid:" />
                <Label Grid.Row="1" Grid.Column="0" Content="AD-Query:" />
                <Label Grid.Row="2" Grid.Column="0" Content="Errors:" />
                <Label Grid.Row="3" Grid.Column="0" Content="Settings:" />
                <CheckBox Grid.Row="0" Grid.Column="1" Content="" IsEnabled="False" IsChecked="{Binding sqlParsedSyntaxValid, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="0,5,5,5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox BorderThickness="0" Text="{Binding sqlParsedAdQueryString, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="{StaticResource PrimaryColor_05}" />
                </ScrollViewer>
                <ScrollViewer  Grid.Row="2" Grid.Column="1" Margin="0,5,5,5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox BorderThickness="0" Text="{Binding sqlParseSyntaxErrorText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="{StaticResource PrimaryColor_05}" />
                </ScrollViewer>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Margin="0,0,5,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal"  VerticalAlignment="Center">
                        <Label Content="Result limit:" />
                        <TextBox x:Name="resultLimit" Text="{Binding pageSize, UpdateSourceTrigger=PropertyChanged}" Width="40"  VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="DeepSearch" IsChecked="{Binding deepSearch}" ToolTip="inkl. subgroups member" />
                    </StackPanel>
                    -->
                </StackPanel>
            </Grid>
        </Grid>


        <!-- Split -->
        <GridSplitter Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Grid.ColumnSpan="3" Background="{StaticResource PrimaryColor_01}" />
        <!-- Result Table -->
            <!-- Produktiv:
            -->
        <DataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Name="dataGridResultTable" ItemsSource="{Binding rowList}"
                  CanUserResizeRows="False" CanUserReorderColumns="False" AutoGenerateColumns="False" IsReadOnly="True"  
                  LayoutUpdated="dataGridResultTable_LayoutUpdated" >
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <!-- 
                    <MenuItem Header="{x:Static p:Resources.L054_Copy}" Command="{Binding cmdCopyClipboard}" >
                        <MenuItem.Icon>
                            <Image Source="/images/CopyTable.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    -->
                    <MenuItem Header="{x:Static p:Resources.L053_Export2}" Command="{Binding cmdOpenExportWindow}" >
                        <MenuItem.Icon>
                            <Image Source="/images/Export.png" />
                        </MenuItem.Icon>
                    </MenuItem>

                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
        
        
        <!-- test
        <DataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Name="dataGridResultTable" LayoutUpdated="dataGridResultTable_LayoutUpdated"
          CanUserResizeRows="False" CanUserReorderColumns="False" AutoGenerateColumns="False" IsReadOnly="True"  >
            <DataGrid.Columns >
                <DataGridTextColumn Header="ID" Width="80"  />
                <DataGridTextColumn Header="Firstname" Width="150" />
                <DataGridTextColumn Header="Lastname" Width="150" />
                <DataGridTextColumn Header="Department" Width="100" />
                <DataGridTextColumn Header="Email" Width="100" />
        </DataGrid.Columns>
        </DataGrid>

        -->

    </Grid>
</UserControl>
